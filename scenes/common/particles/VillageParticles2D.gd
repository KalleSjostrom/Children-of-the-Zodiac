@tool
class_name VillageParticles2D
extends GPUParticles2D
## A particle system of a village or a cutscene on the GPU (plan 6.4): one
## system of maps/ParticleSystems/particleSystems.info, generated by
## tools/import/particles_to_scenes.gd as
## scenes/common/particles/systems/<system>.tscn (how to regenerate and tune:
## docs/CONVERTING_PARTICLES.md). The process material is the shader of the
## system's particle class (fire_particle.gdshader & co.: the legacy laws as
## per-second rates); the texture, blending, amount, emission shape, warm-up
## and background image are the system's. A master system (Pass to Zazo's
## fire) has its slave system (the fire's smoke) as a child, which it runs.
##
## Step B (docs/ARCHITECTURE.md section 9): the legacy BodiesParticleSystem
## stays in charge and builds no bodies. Every frame LegacyParticles2D hands
## the node the legacy system's state (show_state): whether it runs, the game
## time it was updated for, its warm-up, the emitter's position and rate,
## the wind. The particles run for exactly that game time (speed_scale per
## frame), so they stop with the legacy system (a suspended village, a layer
## the legacy code never updates) and run faster with it (a cutscene while
## Circle is held).
##
## Tuning in the editor: intensity, size_scale, and amount (particles are
## emitted at amount / lifetime per second).

## Where the generated scenes are.
const SYSTEMS_DIR := "res://scenes/common/particles/systems/"

## The system's name in particleSystems.info.
@export var system_name := ""
## Multiplies the alpha each particle is drawn with. The generator gives the
## additive systems a softer default than the legacy look, which was too
## bright.
@export_range(0.0, 2.0, 0.01) var intensity := 1.0:
	set(value):
		intensity = value
		_set_parameter(&"intensity", value)
## Multiplies the size each particle is drawn with.
@export_range(0.1, 4.0, 0.01) var size_scale := 1.0:
	set(value):
		size_scale = value
		_set_parameter(&"size_scale", value)
## The legacy emitter's time step (s) the rate was made for (the middle of
## an interval). A longer step than the legacy emitter started with (a
## cutscene's emitter fade) lowers amount_ratio by the same factor.
@export var time_step := 0.0
## Warm up to the steady state when started (a warm-up shape: the snow falls
## everywhere from the start).
@export var warm_up_steady := false
## Steps per second of the warm-up (0: Godot's 30). The snow warms up for
## its longest fall (about 200 s); its law is linear, so 2 steps a second
## reach the same state in a fifteenth of the GPU passes.
@export var warm_up_fps := 0
## The amount the generator computed (amount / lifetime is the legacy rate);
## when amount is tuned, regenerating keeps the ratio.
@export var default_amount := 0

var _started := false
var _first_step := 0.0
var _placing := false
var _warm_frames := 0
var _elapsed := 0.0
var _slave: VillageParticles2D
var _found_slave := false


## The generated scene of the system named definition, or null.
static func scene_for(definition: String) -> PackedScene:
	var path := SYSTEMS_DIR + definition + ".tscn"
	return load(path) if ResourceLoader.exists(path) else null


func _ready() -> void:
	_set_parameter(&"intensity", intensity)
	_set_parameter(&"size_scale", size_scale)
	if Engine.is_editor_hint():
		return
	# A system runs only once the legacy one does (show_state).
	if not _started:
		emitting = false


## The legacy system's state this frame (BodiesParticleSystem.place_particles
## on the GPU path); empty when it is inactive (it draws nothing and does not
## run). "elapsed": the ms the legacy system was updated for since the last
## frame; "warm_up": the s of warm-up its build ran; "seed": the random seed
## of this system; "emitter": the emitter shape's position (local
## coordinates); "step": the emitter's time step now (s); "wind": the wind
## (legacy, y up), for smoke; "image_color": the background image's tint.
func show_state(state: Dictionary) -> void:
	if not _found_slave:
		_found_slave = true
		for child in get_children():
			if child is VillageParticles2D:
				_slave = child
	if state.is_empty():
		visible = false
		_elapsed = 0.0
		if _slave != null:
			_slave.show_state({})
		return
	if not _started:
		_start(state)
	visible = true
	_elapsed += float(state["elapsed"]) / 1000.0
	if not one_shot:
		_set_parameter(&"emitter_origin", state["emitter"])
	if state.has("wind"):
		_set_parameter(&"wind", state["wind"])
	var step: float = state.get("step", _first_step)
	if _first_step > 0.0 and step > _first_step:
		amount_ratio = clampf(_first_step / step, 0.0, 1.0)
	else:
		amount_ratio = 1.0
	var background := get_node_or_null(^"Background") as CanvasItem
	if background != null:
		background.self_modulate = state.get("image_color", Color.WHITE)
	if _slave != null:
		_slave.show_state(state)


func _start(state: Dictionary) -> void:
	_started = true
	_first_step = state.get("step", time_step)
	use_fixed_seed = true
	seed = int(state.get("seed", 0))
	var warm: float = state.get("warm_up", 0.0)
	if warm_up_steady:
		warm = maxf(warm, lifetime)
	preprocess = warm
	if warm > 0.0 and warm_up_fps > 0:
		# Coarse warm-up steps (preprocess steps at fixed_fps), back to every
		# frame once the first frame has been drawn.
		fixed_fps = warm_up_fps
		_warm_frames = 2
	# A one-shot system (the stars: a warm-up shape places them when the legacy
	# system is built) gets one tick to place its particles, even when the
	# legacy system is never updated (the bottom layer).
	_placing = one_shot
	emitting = true
	restart(true)


## The legacy system's time runs the particles: the frame's game time over
## the frame's delta.
func _process(delta: float) -> void:
	if Engine.is_editor_hint() or not _started:
		return
	if _warm_frames > 0:
		_warm_frames -= 1
		if _warm_frames == 0:
			fixed_fps = 0
	if _placing:
		_placing = false
		speed_scale = 1.0
	else:
		speed_scale = _elapsed / delta if delta > 0.0 else 0.0
	_elapsed = 0.0


func _set_parameter(parameter: StringName, value: Variant) -> void:
	var material := process_material as ShaderMaterial
	if material != null:
		material.set_shader_parameter(parameter, value)
