static var _path_to_java := {}
static var _script_cache := {}


## Returns the script for the given Java class name (e.g. "cards.offense.BattleCard").
static func forName(java_name: String) -> GDScript:
	var path: String = JAVA_TO_PATH.get(java_name, "")
	if path == "":
		push_error("ClassRegistry: unknown Java class " + java_name)
		return null
	var s = _script_cache.get(path)
	if s == null:
		s = load(path)
		_script_cache[path] = s
	return s


## Java's Class.forName(name).newInstance().
static func newInstance(java_name: String):
	var s := forName(java_name)
	if s == null:
		return null
	return s.new()


## Java's obj.getClass().getName() (the original Java fully qualified name).
static func getClassName(obj) -> String:
	if obj == null or not (obj is Object):
		return ""
	var script = obj.get_script()
	if script == null:
		return obj.get_class()
	if _path_to_java.is_empty():
		for k in JAVA_TO_PATH:
			_path_to_java[JAVA_TO_PATH[k]] = k
	# Inner classes have no resource path; walk up to the outer script.
	var path: String = script.resource_path
	return _path_to_java.get(path, path)


## Java's obj.getClass().getSimpleName().
static func getSimpleName(obj) -> String:
	var n := getClassName(obj)
	var i := n.rfind(".")
	if i >= 0 and not n.begins_with("res://"):
		return n.substr(i + 1)
	return n.get_file().get_basename()
